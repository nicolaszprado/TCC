generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          BigInt    @id @default(autoincrement())
  name        String    @unique(map: "uq_categories_name") @db.VarChar(100)
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  products    Product[]

  @@map("categories")
}

model Product {
  id          BigInt         @id @default(autoincrement())
  categoryId  BigInt         @map("category_id")
  name        String         @db.VarChar(150)
  description String?
  price       Decimal        @db.Decimal(12, 2)
  stock       Int            @default(0)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  category    Category       @relation(fields: [categoryId], references: [id], map: "fk_products_category")
  details     ProductDetail?
  orderItems  OrderItem[]

  @@index([categoryId], map: "idx_products_category_id")
  @@index([price], map: "idx_products_price")
  @@map("products")
}

model ProductDetail {
  productId      BigInt   @id @map("product_id")
  weightKg       Decimal? @map("weight_kg") @db.Decimal(8, 3)
  widthCm        Decimal? @map("width_cm") @db.Decimal(8, 2)
  heightCm       Decimal? @map("height_cm") @db.Decimal(8, 2)
  depthCm        Decimal? @map("depth_cm") @db.Decimal(8, 2)
  manufacturer   String?  @db.VarChar(150)
  warrantyMonths Int?     @map("warranty_months")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade, map: "fk_product_details_product")

  @@map("product_details")
}

model Customer {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(150)
  email     String   @unique(map: "uq_customers_email") @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  orders    Order[]

  @@map("customers")
}

model Order {
  id         BigInt      @id @default(autoincrement())
  customerId BigInt      @map("customer_id")
  status     String      @db.VarChar(30)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  customer   Customer    @relation(fields: [customerId], references: [id], map: "fk_orders_customer")
  items      OrderItem[]

  @@index([customerId], map: "idx_orders_customer_id")
  @@index([createdAt], map: "idx_orders_created_at")
  @@index([customerId, createdAt(sort: Desc)], map: "idx_orders_customer_created_at")
  @@map("orders")
}

model OrderItem {
  id        BigInt  @id @default(autoincrement())
  orderId   BigInt  @map("order_id")
  productId BigInt  @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "fk_order_items_order")
  product   Product @relation(fields: [productId], references: [id], map: "fk_order_items_product")

  @@unique([orderId, productId], map: "uq_order_product")
  @@index([orderId], map: "idx_order_items_order_id")
  @@index([productId], map: "idx_order_items_product_id")
  @@map("order_items")
}
