# New Relic APM
NEW_RELIC_ENABLED=true
NEW_RELIC_NO_CONFIG_FILE=true
NEW_RELIC_APP_NAME=tcc-orm-benchmark-raw-sql
NEW_RELIC_LICENSE_KEY=replace_with_your_license_key
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
NEW_RELIC_RECORD_SQL=obfuscated
NEW_RELIC_SLOW_SQL_ENABLED=false
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=false
NEW_RELIC_LOG=stdout

# Evita sondagens de provedores de nuvem durante os benchmarks locais.
NEW_RELIC_UTILIZATION_DETECT_AWS=false
NEW_RELIC_UTILIZATION_DETECT_AZURE=false
NEW_RELIC_UTILIZATION_DETECT_AZUREFUNCTION=false
NEW_RELIC_UTILIZATION_DETECT_GCP=false
NEW_RELIC_UTILIZATION_DETECT_PCF=false
NEW_RELIC_UTILIZATION_DETECT_DOCKER=false
NEW_RELIC_UTILIZATION_DETECT_KUBERNETES=false
DOTENV_QUIET=true

# Identifica a implementação nos filtros da interface do New Relic.
NEW_RELIC_LABELS=implementation:raw-sql;environment:benchmark
