{
  "name": "tcc-orm-benchmark",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "dataset:small": "tsx database/seed/generator.ts small",
    "dataset:medium": "tsx database/seed/generator.ts medium",
    "dataset:large": "tsx database/seed/generator.ts large",
    "dataset": "tsx database/seed/generator.ts",
    "db:load": "tsx database/scripts/load.ts",
    "db:reset": "tsx database/scripts/reset.ts",
    "k6:prepare": "tsx tests/k6/tools/prepare-fixtures.ts",
    "k6:run": "tsx tests/k6/tools/run.ts",
    "k6:campaign": "tsx tests/k6/tools/campaign.ts",
    "k6:verify": "tsx tests/k6/tools/verify-writes.ts",
    "test:k6": "node --test tests/k6/unit/*.test.mjs",
    "typecheck:k6": "tsc -p tests/k6/tools/tsconfig.json",
    "prisma:generate": "prisma generate --config apps/prisma/prisma.config.ts",
    "start:raw-sql": "tsx apps/raw-sql/src/server.ts",
    "start:typeorm": "tsx apps/typeorm/src/server.ts",
    "start:prisma": "tsx apps/prisma/src/server.ts",
    "test:raw-sql": "node --import tsx --test apps/raw-sql/test/*.test.ts",
    "test:typeorm": "node --import tsx --test apps/typeorm/test/*.test.ts",
    "test:prisma": "node --import tsx --test apps/prisma/test/*.test.ts",
    "test:shared": "node --import tsx --test apps/shared/*.test.ts",
    "test:integration:equivalence": "node tests/equivalence/api-equivalence.mjs",
    "test": "npm run test:shared && npm run test:raw-sql && npm run test:typeorm && npm run test:prisma",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "csv-stringify": "^6.5.2",
    "dotenv": "^18.0.3",
    "express": "^5.1.0",
    "pg": "^8.13.1",
    "pg-copy-streams": "^6.0.6",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.5",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "eslint": "^10.14.0",
    "prisma": "^7.10.0",
    "sloc": "^0.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1"
  },
  "type": "module"
}
