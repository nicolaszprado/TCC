{
  "name": "tcc-orm-benchmark",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dataset:small": "tsx database/seed/generator.ts small",
    "dataset:medium": "tsx database/seed/generator.ts medium",
    "dataset:large": "tsx database/seed/generator.ts large",
    "dataset": "tsx database/seed/generator.ts",
    "db:load": "tsx database/scripts/load.ts",
    "db:reset": "tsx database/scripts/reset.ts",
    "start:raw-sql": "tsx apps/raw-sql/src/server.ts",
    "check:new-relic": "node --env-file=apps/.env scripts/validate-new-relic-env.mjs",
    "start:raw-sql:apm": "node --env-file=apps/.env --import ./scripts/validate-new-relic-env.mjs --import newrelic/esm-loader.mjs --require newrelic --import tsx apps/raw-sql/src/server.ts",
    "test:raw-sql": "node --import tsx --test apps/raw-sql/test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "csv-stringify": "^6.5.2",
    "dotenv": "^18.0.3",
    "express": "^5.1.0",
    "newrelic": "^14.5.1",
    "pg": "^8.13.1",
    "pg-copy-streams": "^6.0.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "type": "module"
}
