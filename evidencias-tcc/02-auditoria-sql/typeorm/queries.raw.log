/orders?page=1&limit=20
query: query: SELECT COUNT(1) AS "cnt" FROM "orders" "count_order"
query: SELECT "ord"."id" AS "ord_id", "ord"."status" AS "ord_status", "ord"."created_at" AS "ord_created_at", "ord"."updated_at" AS "ord_updated_at", "customer"."id" AS "customer_id", "customer"."name" AS "customer_name", "customer"."email" AS "customer_email", "item"."id" AS "item_id", "item"."quantity" AS "item_quantity", "item"."unit_price" AS "item_unit_price", "product"."id" AS "product_id", "product"."name" AS "product_name" FROM "orders" "ord" INNER JOIN "customers" "customer" ON "customer"."id"="ord"."customer_id"  LEFT JOIN "order_items" "item" ON "item"."order_id"="ord"."id"  LEFT JOIN "products" "product" ON "product"."id"="item"."product_id"  INNER JOIN (SELECT "page_order"."id" AS "id" FROM "orders" "page_order" ORDER BY "page_order"."created_at" DESC, "page_order"."id" DESC LIMIT 20 OFFSET 0) "page" ON page.id = "ord"."id" ORDER BY "ord_created_at" DESC, "ord_id" DESC, "item_id" ASC NULLS LAST

