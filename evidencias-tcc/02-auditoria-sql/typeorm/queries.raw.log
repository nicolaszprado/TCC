query: SELECT "Product"."id" AS "Product_id", "Product"."category_id" AS "Product_category_id", "Product"."name" AS "Product_name", "Product"."description" AS "Product_description", "Product"."price" AS "Product_price", "Product"."stock" AS "Product_stock", "Product"."active" AS "Product_active", "Product"."created_at" AS "Product_created_at", "Product"."updated_at" AS "Product_updated_at" FROM "products" "Product" ORDER BY "Product"."id" ASC LIMIT 20 OFFSET 0


/products?page=1&limit=20&categoryId={{categoryId 1}}&minPrice=1&maxPrice=9999999999.99&active=true

query: SELECT "Product"."id" AS "Product_id", "Product"."category_id" AS "Product_category_id", "Product"."name" AS "Product_name", "Product"."description" AS "Product_description", "Product"."price" AS "Product_price", "Product"."stock" AS "Product_stock", "Product"."active" AS "Product_active", "Product"."created_at" AS "Product_created_at", "Product"."updated_at" AS "Product_updated_at" FROM "products" "Product" WHERE (("Product"."category_id" = $1) AND ("Product"."price" BETWEEN $2 AND $3) AND ("Product"."active" = $4)) ORDER BY "Product"."id" ASC LIMIT 20 OFFSET 0 -- PARAMETERS: ["1","1","9999999999.99",true]
query: SELECT COUNT(1) AS "cnt" FROM "products" "Product" WHERE (("Product"."category_id" = $1) AND ("Product"."price" BETWEEN $2 AND $3) AND ("Product"."active" = $4)) -- PARAMETERS: ["1","1","9999999999.99",true]

